<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

  <!--
    Tracking has to survive the phone going into a pocket. Without a foreground
    service Android throttles background location to a few fixes an hour and
    freezes the process outright once it is cached, which is why a real walk
    recorded 100s of foreground GPS and 0ms of background GPS.

    POST_NOTIFICATIONS is the Android 13+ runtime permission for the service's
    own notification. Denying it does not stop the service or the tracking —
    the notification is simply not shown — so the app asks for it but never
    blocks an errand on the answer.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application
    android:name=".MainApplication"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:allowBackup="false"
    android:theme="@style/AppTheme"
    android:usesCleartextTraffic="${usesCleartextTraffic}"
    android:networkSecurityConfig="@xml/network_security_config"
    android:supportsRtl="true">
    <activity
      android:name=".MainActivity"
      android:label="@string/app_name"
      android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize"
      android:exported="true"
      android:theme="@style/BootTheme">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!--
      `foregroundServiceType` must be declared here as well as passed to
      startForeground(); from Android 14 the two are cross-checked and a
      mismatch throws at start. Not exported: only this app starts it.
    -->
    <service
      android:name=".location.TaskTrackingService"
      android:exported="false"
      android:foregroundServiceType="location" />
  </application>
</manifest>
